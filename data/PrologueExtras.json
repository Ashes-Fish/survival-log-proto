 "Story": [
  {
   "ID": 1501,
   "StoryName": "Story_StoryName_1501",
   "StoryName_Local": "障碍物",
   "IsActivated": true,
   "PlayerSelectId": [],
   "DemoTwoMode": 0,
   "EndlessMode": 0,
   "Des1": "Story_Des1_1501",
   "Des1_Local": "一堆由椅子、箱子等零散家具组成的临时障碍物，死死地顶住了房门。",
   "Des2": "Story_Des2_1501",
   "Des2_Local": "“还好有这些东西顶着，不然着门在几天前就被丧尸冲破了。\\n不过，现在它们反而成为了我出去的障碍……”",
   "Icon": "Assets/RuntimeAssets/Texture/Story/1306",
   "ButtonDes": "Story_ButtonDes_1501",
   "ButtonDes_Local": "确定",
   "StoryThink": "Story_StoryThink_1501",
   "StoryThink_Local": "移开这些东西，得花不少力气",
   "StoryFmod": "event:/Model/Human/chouzhijing",
   "FurnitureFunc": 0,
   "Stage": 2,
   "ShowType": 1,
   "RewardSetId": 10039,
   "ConditionSetId": 0
  },
  {
   "ID": 1502,
   "StoryName": "Story_StoryName_1502",
   "StoryName_Local": "牛皮笔记本",
   "IsActivated": true,
   "PlayerSelectId": [
    1
   ],
   "DemoTwoMode": 0,
   "EndlessMode": 0,
   "Des1": "Story_Des1_1502",
   "Des1_Local": "牛皮封面的厚重笔记本，扉页上写着几个字：生存日志",
   "Des2": "Story_Des2_1502",
   "Des2_Local": "“第12天： 高烧不退，最后一点食物也没了。 若能重活一次，我发誓一定把家里囤满物资，绝不再挨饿！”",
   "Icon": "Assets/RuntimeAssets/Texture/Story/1005",
   "ButtonDes": "Story_ButtonDes_1206",
   "ButtonDes_Local": "确定",
   "StoryThink": "",
   "StoryThink_Local": "",
   "StoryFmod": "event:/Model/Human/chouzhijing",
   "FurnitureFunc": 0,
   "Stage": 2,
   "ShowType": 2,
   "RewardSetId": 0,
   "ConditionSetId": 0
  },
  {
   "ID": 1503,
   "StoryName": "Story_StoryName_1503",
   "StoryName_Local": "窗外",
   "IsActivated": true,
   "PlayerSelectId": [
    1
   ],
   "DemoTwoMode": 0,
   "EndlessMode": 0,
   "Des1": "Story_Des1_1503",
   "Des1_Local": "从木板的间隙向外看，街道上一片狼藉。车祸撞毁车辆丢弃在路上，断续冒着烟雾。",
   "Des2": "Story_Des2_1503",
   "Des2_Local": "“路上没有一个人，也没有发现“它们”，只在远处传来隐约嘶吼。\\n也许这是我脱困的最后机会……”",
   "Icon": "Assets/RuntimeAssets/Texture/Story/1034",
   "ButtonDes": "Story_ButtonDes_1503",
   "ButtonDes_Local": "确定",
   "StoryThink": "Story_StoryThink_1503",
   "StoryThink_Local": "外面看起来不太安全…",
   "StoryFmod": "event:/Model/Human/chouzhijing",
   "FurnitureFunc": 0,
   "Stage": 2,
   "ShowType": 2,
   "RewardSetId": 0,
   "ConditionSetId": 0
  }
 ],
