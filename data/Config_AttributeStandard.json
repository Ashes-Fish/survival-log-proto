[
  {
    "ID": 1,
    "Name": "Satiety",
    "Des": "AttributeStandard_Des_1",
    "Des_Local": "饱腹",
    "Min": 0,
    "Max": 2147483647,
    "IsSingle": true,
    "TIPSDes": "AttributeStandard_TIPSDes_1",
    "TIPSDes_Local": "如果你饿得不行，就吃点东西吧。\\n低于30会陷入【饥饿】，等于零时会【极度饥饿】并自行寻找食物"
  },
  {
    "ID": 2,
    "Name": "Morale",
    "Des": "AttributeStandard_Des_2",
    "Des_Local": "心态",
    "Min": 0,
    "Max": 2147483647,
    "IsSingle": true,
    "TIPSDes": "AttributeStandard_TIPSDes_2",
    "TIPSDes_Local": "表示你心情好坏的指标。\\n低于30会陷入【沮丧】\\n饱腹和精力良好时，心态会缓慢恢复。许多有趣的行为和事件，也会改变心态。\\n每天结束时，心态超过50的部分会被转化为额外生存点，非常有用！"
  },
  {
    "ID": 3,
    "Name": "Stamina",
    "Des": "AttributeStandard_Des_3",
    "Des_Local": "精力",
    "Min": 0,
    "Max": 2147483647,
    "IsSingle": true,
    "TIPSDes": "AttributeStandard_TIPSDes_3",
    "TIPSDes_Local": "很多事情会消耗精力，你需要休息来恢复。\\n低于30会陷入【疲劳】并自行进行休息，等于零时会【极度疲劳】损害健康和生命"
  },
  {
    "ID": 4,
    "Name": "Health",
    "Des": "AttributeStandard_Des_4",
    "Des_Local": "健康",
    "Min": 0,
    "Max": 2147483647,
    "IsSingle": true,
    "TIPSDes": "AttributeStandard_TIPSDes_4",
    "TIPSDes_Local": "良好的健康可以降低疾病的概率。\\n低于30会陷入【亚健康】\\n长期【饥饿】和【疲劳】会影响健康"
  },
  {
    "ID": 5,
    "Name": "Vitality",
    "Des": "AttributeStandard_Des_5",
    "Des_Local": "生命",
    "Min": 0,
    "Max": 2147483647,
    "IsSingle": true,
    "TIPSDes": "AttributeStandard_TIPSDes_5",
    "TIPSDes_Local": "表示你生命力的指标。\\n低于30会陷入【虚弱】，等于零时你会死亡！\\n持续【极度饥饿】【极度疲劳】会损耗生命"
  },
